AGENT_WEB_SEARCH_ENABLED=true
LOG_LEVEL=INFO

# REQUIRED to store provider API keys. Provider keys are encrypted at rest with
# this value (Fernet); without it (or if shorter than 16 chars) the app refuses
# to save keys rather than storing them in plaintext.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=

# Product/runtime persistence.
# PostgreSQL is the only supported product/runtime database.
# Local compose default:
AGENTIC_DATABASE_URL=postgresql://agentic:agentic_dev_password@127.0.0.1:54329/agentic_company
AGENTIC_POSTGRES_POOL_MIN=1
AGENTIC_POSTGRES_POOL_MAX=10

# Optional transient Redis runtime cache/pubsub/stop flags. Never source of truth.
# Local compose default:
AGENTIC_REDIS_URL=redis://127.0.0.1:6380/0
AGENTIC_WEB_PORT=8503

# Runtime profile (Phase 3): local (default, dev-friendly) or vm_mvp (shared host —
# `agentic-doctor` exits non-zero if PostgreSQL/GitHub CLI/Codex auth aren't ready).
AGENTIC_RUNTIME_PROFILE=local

# ===== GitHub OAuth (console "Login with GitHub" + repo picker) =====
# Register an OAuth App: https://github.com/settings/applications/new
#   Homepage URL:             http://127.0.0.1:8503
#   Authorization callback URL: http://127.0.0.1:8503/auth/github/callback
# Then paste the Client ID + a generated Client Secret below. The secret is read
# only from this file and never logged. Requires APP_SECRET_KEY (above) to store
# the per-user access token encrypted at rest.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Override the OAuth redirect for a hosted deploy (e.g. the VM's public HTTPS URL).
# Must match the OAuth App's Authorization callback URL.
# GITHUB_OAUTH_CALLBACK_URL=https://your-host/auth/github/callback

# Optional LangSmith tracing for LangChain/LangGraph calls.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-company

# Optional Codex worker configuration.
# CODEX_BINARY can point at a specific Codex executable when it is not on PATH.
# AGENTIC_CODEX_BINARY_MODE selects discovery when CODEX_BINARY is empty.
# Allowed values: auto, npm, extension.
CODEX_BINARY=
AGENTIC_CODEX_BINARY_MODE=auto

# Codex authentication mode (Phase 3):
#   user_chatgpt — each user connects their own ChatGPT/Codex account in Settings.
AGENTIC_CODEX_AUTH_MODE=user_chatgpt
# App-owned root for per-user Codex auth dirs. Do not set CODEX_HOME globally.
AGENTIC_CODEX_AUTH_ROOT=

# Optional Azure deployment defaults for local/VM parity.
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=

# Codex sandbox. Leave unset: each worker role pins its own least-privilege level
# (planning + fullstack + QA + handoff: workspace-write; only deployment opts into
# danger-full-access). Roles that force their own sandbox ignore this variable;
# setting it only affects the QA/handoff defaults, so use it solely to debug locally.
# Allowed values: read-only, workspace-write, danger-full-access.
# AGENTIC_CODEX_SANDBOX=workspace-write

# Set to false/0/no/off to avoid passing shell_environment_policy.inherit=all.
AGENTIC_CODEX_INHERIT_ENV=true

# QA browser screenshots: point Playwright at a pre-installed Chromium so the QA
# worker can capture evidence under workspace-write. One-time setup:
#   npm --prefix ops/qa-runtime install playwright
#   $env:PLAYWRIGHT_BROWSERS_PATH="$(Resolve-Path .)\ops\qa-runtime\browsers"
#   node ops/qa-runtime/node_modules/playwright/cli.js install chromium
# Then point the worker at the install (paths inherited into the Codex subprocess):
# PLAYWRIGHT_BROWSERS_PATH=ops/qa-runtime/browsers
# NODE_PATH=ops/qa-runtime/node_modules

# Optional cache overrides. If empty, caches are created inside generated-project/.
AGENTIC_CODEX_UV_CACHE_DIR=
AGENTIC_CODEX_DENO_DIR=
AGENTIC_CODEX_NPM_CACHE=
