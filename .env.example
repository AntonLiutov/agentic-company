OPENAI_API_KEY=
GOOGLE_API_KEY=
AGENT_GEMINI_API_KEY=
GEMINI_FORMATTER_API_KEY=
AGENTIC_FORMATTER_MODEL=gemini-3.1-flash-lite
SPEECHMATICS_API_KEY=
SPEECHMATICS_REGION=eu
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2
AGENT_LLM_PROVIDER=google_gemini
AGENT_LLM_MODEL=gemini-3-flash-preview

# AgentExecutor shells use tiered reasoning:
# - Keep coordinator/specialist shells deterministic and cheap.
# - Codex workers do the coding-heavy work.
COORDINATOR_AGENT_REASONING_EFFORT=none
SPECIALIST_AGENT_REASONING_EFFORT=none

AGENT_WEB_SEARCH_ENABLED=true
LOG_LEVEL=INFO

# Optional LangSmith tracing for LangChain/LangGraph calls.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-company

# Optional Codex worker configuration.
# CODEX_BINARY can point at a specific Codex executable when it is not on PATH.
# AGENTIC_CODEX_BINARY_MODE selects discovery when CODEX_BINARY is empty.
# Allowed values: auto, npm, extension.
CODEX_BINARY=
AGENTIC_CODEX_BINARY_MODE=auto
AGENT_CODEX_MODEL=gpt-5.3-codex
AGENTIC_CODEX_REASONING_EFFORT=medium
AGENTIC_CODEX_SERVICE_TIER=fast

# Optional Azure deployment defaults for local/VM parity.
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_SUBSCRIPTION_ID=

# Codex specialist workers default to trusted local delivery permissions.
# Allowed values: read-only, workspace-write, danger-full-access.
AGENTIC_CODEX_SANDBOX=danger-full-access

# Set to false/0/no/off to avoid passing shell_environment_policy.inherit=all.
AGENTIC_CODEX_INHERIT_ENV=true

# Optional cache overrides. If empty, caches are created inside generated-project/.
AGENTIC_CODEX_UV_CACHE_DIR=
AGENTIC_CODEX_DENO_DIR=
AGENTIC_CODEX_NPM_CACHE=
