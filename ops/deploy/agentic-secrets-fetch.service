# Installed at /etc/systemd/system/agentic-secrets-fetch.service by bootstrap_vm.sh.
# Renders /opt/agentic-company/shared/.env from Key Vault via the VM's managed identity
# BEFORE the console starts. RemainAfterExit so the console's Requires= is satisfied.
[Unit]
Description=Render console secrets from Azure Key Vault
After=network-online.target
Wants=network-online.target
Before=agentic-company-console.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=deployer
Group=deployer
ExecStart=/opt/agentic-company/shared/bin/fetch-secrets.sh

[Install]
WantedBy=multi-user.target
