# NON-SECRET per-env config for the dev environment. Committed on purpose — NO secrets
# here. fetch-secrets.sh sources this (to compose the DB URL + know the vault) and also
# appends it verbatim into the rendered shared/.env, so these become the app's env vars.
# Copy to env.nonsecret.staging / .prod with each env's own vault, PG host, callback URL.

# --- Key Vault this env reads its secrets from ---
AGENTIC_KEY_VAULT=kv-agentic-dev

# --- Postgres Flexible Server (host/db/user are non-secret; the password is in Key Vault) ---
AGENTIC_PG_HOST=pg-agentic-dev.postgres.database.azure.com
AGENTIC_PG_DB=agentic_company
AGENTIC_PG_USER=agentic

# --- Web ---
AGENTIC_WEB_HOST=127.0.0.1
AGENTIC_WEB_PORT=8503

# --- Redis (docker on the VM; ephemeral cache, no durable secrets) ---
AGENTIC_REDIS_URL=redis://127.0.0.1:6379/0

# --- GitHub OAuth callback (this env's DNS; the client id/secret live in Key Vault) ---
GITHUB_OAUTH_CALLBACK_URL=https://dev.example.com/auth/github/callback

# --- Codex (per-user web login via the standalone binary) ---
AGENTIC_CODEX_AUTH_MODE=user_chatgpt
AGENTIC_CODEX_BINARY_MODE=auto
AGENTIC_CODEX_AUTH_ROOT=data/codex-auth

# --- Runtime profile (VM, not local) ---
AGENTIC_RUNTIME_PROFILE=vm_mvp

# NOTE: never add AGENTIC_CODEX_SANDBOX_OVERRIDE here — host-wide danger-full-access
# must stay a LOCAL-only knob.
