# Template for the per-host prod secrets file. The real file lives ONLY at
# /opt/agentic-company/shared/.env (0600, deployer:deployer), is symlinked into each
# release, and is NEVER written or overwritten by a deploy. Each environment
# (dev / staging / prod) gets its OWN file + its OWN GitHub OAuth app (a GitHub OAuth
# app allows exactly one callback URL). Copy this, fill real values; the real file is
# gitignored — never commit secrets.

# --- Web ---
AGENTIC_WEB_HOST=127.0.0.1
AGENTIC_WEB_PORT=8503

# --- Datastores (docker compose on the VM) ---
AGENTIC_DATABASE_URL=postgresql://agentic:<password>@127.0.0.1:5432/agentic_company
AGENTIC_REDIS_URL=redis://127.0.0.1:6379/0

# --- Session / crypto: generate FRESH per host; never share across environments ---
APP_SECRET_KEY=<fernet-key>

# --- GitHub OAuth app (one app + one callback URL per environment) ---
GITHUB_OAUTH_CLIENT_ID=<client-id>
GITHUB_OAUTH_CLIENT_SECRET=<client-secret>
GITHUB_OAUTH_CALLBACK_URL=https://<env-dns>/auth/github/callback

# --- Codex (per-user web login via the STANDALONE binary; see vm-runbook) ---
AGENTIC_CODEX_AUTH_MODE=user_chatgpt
AGENTIC_CODEX_BINARY_MODE=auto
AGENTIC_CODEX_AUTH_ROOT=data/codex-auth

# --- Runtime profile (VM, not local) ---
AGENTIC_RUNTIME_PROFILE=vm_mvp

# NOTE: do NOT set AGENTIC_CODEX_SANDBOX_OVERRIDE on the VM — host-wide
# danger-full-access must stay a LOCAL-only knob (see phase-3-review-followups).
