# Installed at /etc/sudoers.d/agentic-deployer (mode 0440) by bootstrap_vm.sh.
# The `deployer` user (which runs the GitHub Actions self-hosted runner) may ONLY
# restart and inspect the console service — nothing else, no password.
deployer ALL=(root) NOPASSWD: /usr/bin/systemctl restart agentic-company-console, /usr/bin/systemctl is-active agentic-company-console, /usr/bin/systemctl status agentic-company-console
