{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-company.local/agents/planning/schemas/intake-brief.schema.json",
  "title": "Intake Brief",
  "type": "object",
  "required": [
    "project_name",
    "source_path",
    "goal",
    "target_user",
    "core_features",
    "required_configuration",
    "preferred_stack",
    "non_goals",
    "acceptance_criteria",
    "open_questions"
  ],
  "properties": {
    "project_name": { "type": "string" },
    "source_path": { "type": "string" },
    "goal": { "type": "string" },
    "target_user": { "type": "string" },
    "core_features": { "type": "array", "items": { "type": "string" } },
    "required_configuration": { "type": "array", "items": { "type": "string" } },
    "preferred_stack": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
